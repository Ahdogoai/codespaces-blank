    <h1>Select Your Airport and Transfer Service</h1>
    <form id="transferForm"></form>
        <<div>
            <label for="airportSelect">Select Airport:</label>
            <select id="airportSelect" name="airport" required>
                <option value="">-- Select an Airport --</option>
                <option value="MPH">Caticlan Airport (MPH)</option>
                <option value="KLO">Kalibo Airport (KLO)</option>
                <option value="NAIA">Manila Airport (NAIA)</option>
                <option value="CEB">Mactan-Cebu Airport (CEB)</option>
            </select>
        </div>
    
        <div id="tripTypeSection" class="trip-type-options">
            <label>Select Trip Type:</label>
            <div class="radio-group">
