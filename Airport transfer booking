                <label for="oneWayArrival">Arrival One-way</label>
                <input type="radio" id="oneWayDeparture" name="trip_type" value="Departure One-way">
                <label for="oneWayDeparture">Departure One-way</label>
                <input type="radio" id="roundTrip" name="trip_type" value="Round Trip">
                <label for="roundTrip">Round Trip</label>
            </div>
        </div>
    
        <div id="passengerSection" class="passenger-options">
            <label>Enter Number of Passengers:</label>
            <div>
            </div>
            <div>
            </div>
            <div>
            </div>
        </div> <!-- Close the unclosed div -->
    
