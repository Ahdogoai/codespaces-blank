                <input type="number" id="adultsCount" name="adults" class="passenger-input" value="1" min="1" max="15" required>
            </div>
            <div>
                <label for="seniorCount">Senior (60+):</label>
                 <input type="number" id="seniorCount" name="senior" class="passenger-input" value="0" min="0" max="15">
            </div>
             <p id="payingGuestWarning" class="error" style="display: none;">Please select at least one Adult or Senior passenger.</p>
              <p id="totalGuestWarning" class="error" style="display: none;">Total Adults + Seniors cannot exceed 15 for pricing calculation based on available data.</p>
        </div>
    
    
        <div id="datetimeSection" class="datetime-options">
            <div id="oneWayDateTime" class="datetime-group" style="display: none;">
                 <label for="oneWayDate">Date & Time:</label>
                 <input type="datetime-local" id="oneWayDate" name="one_way_datetime">
            </div>
            <div id="roundTripDateTime" class="datetime-group" style="display: none;">
                 <label for="arrivalDate">Arrival Date & Time:</label>
                 <input type="datetime-local" id="arrivalDate" name="arrival_datetime">
                 <label for="departureDate">Departure Date & Time:</label>
                 <input type="datetime-local" id="departureDate" name="departure_datetime">
            </div>
        </div>
    
    
        <div id="transferMph" class="transfer-options">
            <label for="transferMphSelect">Transfer service (MPH):</label>
            <select id="transferMphSelect" name="transfer_mph" class="transfer-select" required>
                <option value="">-- Select Transfer Service --</option>
                <option value="standard_mph">✈️ STANDARD AIRPORT TRANSFER (MPH)</option>
