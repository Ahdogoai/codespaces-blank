        // Function to parse currency string to number (handles ₱ and commas)
        function parseCurrency(currencyString) {
             if (!currencyString) return 0;
             // Remove ₱, commas, and spaces, then parse as float
             return parseFloat(currencyString.replace(/[₱,\s]/g, ''));
        }
    
         // Function to format number as currency (PHP)
        function formatCurrency(number) {
            // Use Intl.NumberFormat for better currency formatting
            try {
                return new Intl.NumberFormat('en-PH', {
                    style: 'currency',
                    currency: 'PHP',
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(number);
            } catch (e) {
                // Fallback if Intl.NumberFormat is not supported
                console.error("Intl.NumberFormat not supported, falling back to manual formatting:", e);
                return '₱' + number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            }
        }
    
    
