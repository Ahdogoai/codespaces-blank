                     return;
                 }
                 const arrivalDateTime = new Date(arrivalDateInput.value);
                 const departureDateTime = new Date(departureDateInput.value);
                 if (departureDateTime < arrivalDateTime) {
                      alert('Departure Date & Time cannot be before Arrival Date & Time.');
