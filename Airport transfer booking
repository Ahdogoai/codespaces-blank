                <option value="vip_helicopter_naia">👑V.I.P HELICOPTER AIRPORT TRANSFER (NAIA)</option>
            </select>
        </div>
    
        <div id="transferCeb" class="transfer-options">
            <label for="transferCebSelect">Transfer service (CEB):</label>
            <select id="transferCebSelect" name="transfer_ceb" class="transfer-select" required>
